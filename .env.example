# Banco de dados (Postgres). Em produção na Vercel, a integração de Postgres
# preenche isso sozinha (ver docs/deployment.md). Em desenvolvimento local, aponte
# para um Postgres seu — local (ex: postgresql://postgres:SENHA@localhost:5432/lucrativa_dev)
# ou uma branch gratuita da Neon/Vercel Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lucrativa_dev"
# Conexão direta (sem pgbouncer), usada só por `prisma db push`/`migrate`. Na Vercel
# Postgres/Neon isso vem pronto num env var próprio — localmente é a mesma URL acima.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lucrativa_dev"

# Claude API (Research, Strategy, Content, Chat) — https://console.anthropic.com/settings/keys
# Sem esta chave, os agentes de IA ficam desligados e o sistema avisa em vez de simular resposta.
ANTHROPIC_API_KEY=""

# Modelos por agente (ajuste para controlar custo — ver docs/agents.md e REGRA 38)
CLAUDE_MODEL_RESEARCH="claude-sonnet-5"
CLAUDE_MODEL_STRATEGY="claude-sonnet-5"
CLAUDE_MODEL_CONTENT="claude-sonnet-5"
CLAUDE_MODEL_CHAT="claude-sonnet-5"

# Provedor de geração de imagem (Creative Agent). Deixe em branco para operar em modo
# MOCK (gera apenas o briefing visual estruturado, sem imagem real) — nunca finge uma
# integração que não existe (REGRA 12).
IMAGE_PROVIDER=""          # "" | "openai" | "stability"
IMAGE_PROVIDER_API_KEY=""

# URL base pública (para links curtos/rastreáveis e páginas de inscrição)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Identidade do tenant inicial criado pelo seed
SEED_CLIENT_SLUG="lucrattiva"
SEED_CLIENT_NAME="Lucrattiva Contabilidade"

# Senha compartilhada do dashboard (/campanhas e APIs internas). Em branco =
# SEM autenticação (ok para desenvolvimento local; defina antes de publicar,
# já que o dashboard mostra dado pessoal de participantes — ver docs/deployment.md).
DASHBOARD_PASSWORD=""
